{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Technology Selection Schema",
  "description": "Each entry defines a capability the system must provide and the specific technology chosen to fulfill it.",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "type": {
      "const": "technology_selection"
    },
    "generated_at": {
      "type": "string",
      "format": "date"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "capability",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TS-[a-z0-9-]+(-v[0-9]+)?$"
          },
          "replaces_id": {
            "type": "string",
            "pattern": "^TS-[a-z0-9-]+(-v[0-9]+)?$"
          },
          "module": {
            "type": "string",
            "description": "Logical module or feature area this technology selection belongs to. Used to scope implementation work and detect module reassignment during updates."
          },
          "implementation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "*"
            ]
          },
          "category": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "decision_ref": {
            "type": "string"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
