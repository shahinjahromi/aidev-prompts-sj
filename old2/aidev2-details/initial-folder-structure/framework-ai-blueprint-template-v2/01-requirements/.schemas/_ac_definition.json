{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Acceptance Criteria Definition",
  "description": "Reusable definition for structured acceptance criteria embedded in FR/NFR items",
  "type": "object",
  "required": ["id", "title"],
  "properties": {
    "id": { "type": "string", "pattern": "^AC-[0-9]{6}$" },
    "title": { "type": "string" },
    "context": { "type": "string", "description": "The precondition or state before the action" },
    "criteria": {
      "type": "array",
      "description": "List of atomic conditions that must be true for completion",
      "items": { "type": "string" },
      "minItems": 1
    },
    "scenarios": {
      "type": "array",
      "description": "Behavioral Given/When/Then scenarios",
      "items": {
        "type": "object",
        "required": ["name", "given", "when", "then"],
        "properties": {
          "name": { "type": "string" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        }
      }
    },
    "acceptance_tests": {
      "type": "array",
      "items": { "$ref": "_at_definition.json" }
    }
  }
}
