{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Models and Contracts Schema",
  "type": "object",
  "required": ["schema_version", "type", "generated_at", "items"],
  "properties": {
    "schema_version": { "type": "integer" },
    "type": { "const": "models_and_contracts" },
    "generated_at": { "type": "string", "format": "date" },
    "version": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "logical_id", "title", "summary", "spec_format", "spec_path"],
        "properties": {
          "id": { "type": "string", "pattern": "^MAC-[0-9]{7}-[a-z0-9-]+(-v[0-9]+)?$" },
          "module": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Module slug this contract belongs to. Groups contract spec files under a module sub-folder and allows AI to scope reads to only relevant modules."
          },
          "logical_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Stable contract identity preserved across versions. Replacements must keep the same logical_id."
          },
          "replaces_id": {
            "type": "string",
            "pattern": "^MAC-[0-9]{7}-[a-z0-9-]+(-v[0-9]+)?$",
            "description": "Original MAC id superseded by this entry. Required when action is 'update'. New entry must use the next available sequence number, not the same number as replaces_id."
          },
          "action": {
            "type": "string",
            "enum": ["update", "delete"],
            "description": "Omit this field for new catalog entries (create). Use 'update' for versioned replacements of promoted entries (requires replaces_id). Use 'delete' for removal entries (requires replaces_id)."
          },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "spec_format": { "type": "string", "enum": ["openapi_yaml", "graphql_sdl_yaml", "logical_database_schema", "physical_database_schema", "domain_model"] },
          "spec_path": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "id": { "pattern": "-v[0-9]+$" }
              },
              "required": ["id"]
            },
            "then": {
              "required": ["replaces_id"]
            }
          }
        ]
      }
    }
  }
}
