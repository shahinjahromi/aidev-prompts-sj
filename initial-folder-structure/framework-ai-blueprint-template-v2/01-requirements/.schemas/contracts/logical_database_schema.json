{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Logical Database Schema Contract",
  "type": "object",
  "required": ["schema_name", "entities", "relationships"],
  "properties": {
    "schema_name": { "type": "string" },
    "description": { "type": "string" },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "attributes"],
        "properties": {
          "name": { "type": "string" },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "nullable": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": { "type": "string", "enum": ["one_to_one", "one_to_many", "many_to_many"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
