{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Functional Requirements Schema (Structured)",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "type": {
      "const": "functional_requirements"
    },
    "generated_at": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "section"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FR-[0-9]{7}-[a-z0-9-]+(-v[0-9]+)?$"
          },
          "replaces_id": {
            "type": "string",
            "pattern": "^FR-[0-9]{7}-[a-z0-9-]+(-v[0-9]+)?$",
            "description": "ID of the promoted requirement this entry supersedes. New entry must have the next available sequence number, not the same number as replaces_id."
          },
          "module": {
            "type": "string",
            "description": "Logical module or feature area this requirement belongs to. Used to scope implementation work and detect module reassignment during updates."
          },
          "action": {
            "type": "string",
            "enum": [
              "update",
              "delete"
            ],
            "description": "Omit this field for new requirements (create). Use 'update' for versioned replacements of promoted requirements (requires replaces_id). Use 'delete' for removal entries (requires replaces_id, empty text)."
          },
          "text": {
            "type": "string",
            "description": "Requirement text. Empty when action is 'delete'."
          },
          "section": {
            "type": "string"
          },
          "contract_refs": {
            "type": "array",
            "description": "References to MAC or UIC catalog entries. When referencing a MAC whose spec file contains many items (e.g. ui_contracts.yaml), list the referenced item IDs in sub_mac_ids.",
            "items": {
              "type": "object",
              "required": [
                "contract_type",
                "selection"
              ],
              "properties": {
                "contract_type": {
                  "type": "string",
                  "enum": [
                    "models_and_contracts",
                    "ui_contracts"
                  ]
                },
                "selection": {
                  "type": "string",
                  "enum": [
                    "all",
                    "specific_ids"
                  ]
                },
                "specific_ids": {
                  "type": "array",
                  "description": "MAC or UIC references when selection is 'specific_ids'. Each entry uses either 'id' or 'logical_id' and may include 'sub_mac_ids'.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The MAC or UIC ID being referenced."
                      },
                      "logical_id": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]+$",
                        "description": "Stable MAC logical identifier. The authoring workflow resolves this to the latest matching MAC ID."
                      },
                      "sub_mac_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "When this MAC entry's spec file contains many named sub-items (e.g. UIC IDs in ui_contracts.yaml, endpoint IDs in an OpenAPI spec), list every sub-item ID this requirement depends on here."
                      }
                    },
                    "anyOf": [
                      {
                        "required": [
                          "id"
                        ]
                      },
                      {
                        "required": [
                          "logical_id"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "implements_contract_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^MAC-[0-9]{7}-[a-z0-9-]+(-v[0-9]+)?$"
            },
            "description": "MAC IDs of contracts this requirement implements (provides/exposes)."
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "$ref": "_ac_definition.json"
            }
          },
          "acceptance_tests": {
            "type": "array",
            "items": {
              "$ref": "_at_definition.json"
            }
          }
        }
      }
    }
  }
}
