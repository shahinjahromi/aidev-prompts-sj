{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Application Requirements Manifest Schema",
  "description": "Schema for the per-application requirements manifest consumed by the diff, plan, and execute pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "requirement_set_id",
    "app_identifier",
    "implementation_id",
    "iteration_id",
    "requirements_version_target",
    "requirements_version_implemented",
    "requirement_baseline"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "requirement_set_id": {
      "type": "string",
      "minLength": 1
    },
    "app_identifier": {
      "type": "string",
      "minLength": 1
    },
    "implementation_id": {
      "type": "string",
      "minLength": 1
    },
    "iteration_id": {
      "type": "integer",
      "minimum": 0
    },
    "requirements_version_target": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "requirements_version_implemented": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "requirement_baseline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "pinned_version",
          "functional_test_status"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^(FR-[0-9]{7}|NFR-[0-9]{7}|GLOBAL-[0-9]{7}|TS-[0-9]{7}|MAC-[0-9]{7}|UIC-[0-9]{7})(-[a-z0-9-]+)?(-v[0-9]+)?$"
          },
          "pinned_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "module": {
            "type": "string",
            "description": "Logical module or feature area. Used to detect module reassignment during updates."
          },
          "functional_test_status": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "first_version",
              "current_version",
              "tested_version"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "unspecified",
                  "passed",
                  "failed"
                ]
              },
              "first_version": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "current_version": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "tested_version": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              }
            }
          },
          "e2e_test_status": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "first_version",
              "current_version",
              "tested_version"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "unspecified",
                  "passed",
                  "failed"
                ]
              },
              "first_version": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "current_version": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "tested_version": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              }
            }
          },
          "implementation_initial_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 date-time when the requirement was first implemented."
          },
          "implementation_last_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 date-time of the most recent implementation update for this requirement."
          }
        }
      }
    }
  }
}
